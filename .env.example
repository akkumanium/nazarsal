# Supabase: Settings > Database > Connect > Session pooler (port 5432).
# Percent-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
# Optional embedded development PostgreSQL + experimental PostGIS, no Docker.
# Leave DATABASE_URL empty and set LOCAL_DATABASE_PATH=.local/postgres to enable.
LOCAL_DATABASE_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ORS_API_KEY=
# Routing provider: ors (default) or geoapify. Only the selected key is required.
ROUTING_PROVIDER=ors
GEOAPIFY_API_KEY=
# These are server-side settings. Never prefix secrets with NEXT_PUBLIC_.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=NazarSalAstana/1.0 (local hackathon prototype)
OVERPASS_PAUSE_MS=2000
# Optional known city relation ID, or a local Overpass JSON boundary response.
ASTANA_BOUNDARY_RELATION_ID=3087156
ASTANA_BOUNDARY_FILE=
# Optional exact RFC3339 snapshot. Otherwise use the boundary response timestamp.
OSM_SNAPSHOT=
MAX_DAILY_RECOMMENDATIONS=500
